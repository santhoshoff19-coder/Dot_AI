DATABASE_URL="file:./dev.db"
MOCK_MODE=true
OPENROUTER_API_KEY=

# --- Routing -----------------------------------------------------------------
# Fast Router confidence needed to skip CAI for an ordinary task.
FAST_ROUTE_MIN_CONFIDENCE=0.88
# Stricter bar for routing a high-risk task directly.
HIGH_RISK_DIRECT_CONFIDENCE=0.9
# At or below this, always escalate to CAI.
CAI_TRIGGER_CONFIDENCE=0.75
# CAI classifies only - keep it cheap. Never the model that writes the answer.
CAI_MODEL=google/gemini-2.5-flash-lite
CAI_MAX_COST_USD=0.002
# Observed runs required before learned reliability influences routing.
RELIABILITY_MIN_SAMPLE=5
# Auto mode runs the recommended model without asking.
AUTO_MODE_DEFAULT=true

# --- CAI benchmark thresholds ------------------------------------------------
# The cheapest candidate clearing ALL of these wins. Cost alone never does.
MIN_CAI_ACCURACY=0.75
MIN_CAI_SCHEMA_SUCCESS=0.95
MAX_CAI_LATENCY=4000
MAX_CAI_COST_PER_REQUEST=0.0005
